# Account request generated by account-factory Lambda
# Account: {{ account_name }}

resource "aws_organizations_account" "{{ resource_name }}" {
  name      = "{{ account_name }}"
  email     = "{{ account_email }}"
  parent_id = "{{ parent_id }}"
  role_name = "{{ role_name }}"

  # Close account on destroy (AWS closes; permanent deletion is delayed)
  close_on_deletion = true

  tags = {
{% for k, v in account_tags.items() %}
    {{ k }} = "{{ v }}"
{% endfor %}
    ManagedBy = "account-factory"
  }

  lifecycle {
    ignore_changes = [role_name]
  }
}
